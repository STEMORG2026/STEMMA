      ],
      "name": "transcription",
      "entityType": "process",
      "status": "canonical",
      "definition": "The synthesis of an RNA copy from a DNA template, catalysed by RNA polymerase. In eukaryotes the initial transcript is processed before it leaves the nucleus, and it carries the coding or regulatory information of a gene.",
      "provenance": {
        "aiDrafted": true,
