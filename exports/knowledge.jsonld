      ],
      "name": "enzyme",
      "entityType": "material",
      "status": "canonical",
      "definition": "An enzyme acts as a catalyst in biochemical reactions, typically functioning as a complex protein. It accelerates specific metabolic pathways without being consumed during the reaction.",
