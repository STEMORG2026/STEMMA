      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "organelle",
      "entityType": "structure",
      "status": "canonical",
      "definition": "A membrane-bound or structurally distinct compartment inside a cell that carries out a specialized function. Examples include mitochondria for energy conversion, ribosomes for protein synthesis, and the nucleus for storing genetic material.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
