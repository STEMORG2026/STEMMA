    {
      "@id": "stemma:bio.abiotic",
      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "abiotic",
      "entityType": "concept",
      "status": "canonical",
      "definition": "Abiotic components are the nonliving physical and chemical factors of an ecosystem, such as sunlight, temperature, water, and soil. They shape organism survival and are distinguished from biotic factors such as predators and competitors.",
      "provenance": {
        "aiDrafted": true,
