      ],
      "name": "activated complex",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The activated complex, also known as the transition state, represents an unstable arrangement of atoms occurring at the peak energy barrier during a chemical transformation. This fleeting species possesses partial bonds and exists momentarily before decomposing into either reactants or products.",
      "provenance": {
        "aiDrafted": true,
