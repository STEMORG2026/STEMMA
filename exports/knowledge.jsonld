      ],
      "name": "refactoring",
      "entityType": "process",
      "status": "canonical",
      "definition": "Refactoring is the disciplined process of restructuring existing source code to improve its internal structure without altering external behavior. This technique enhances readability and maintainability, reducing technical debt while ensuring that functional requirements remain completely unchanged.",
