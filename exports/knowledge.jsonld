        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "metabolism",
      "entityType": "process",
      "status": "canonical",
      "definition": "Metabolism encompasses all chemical reactions occurring inside cells, including anabolic and catabolic pathways. It manages energy conversion and synthesis of cellular components essential for life.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
