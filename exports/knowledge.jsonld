        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "hormone",
      "entityType": "concept",
      "status": "canonical",
      "definition": "A hormone is a chemical signaling molecule, typically composed as proteins or steroids, secreted directly into the bloodstream by endocrine cells. These molecules travel to distant target organs where they regulate specific physiological processes like growth and metabolism.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
