        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "abductor",
      "entityType": "concept",
      "status": "canonical",
      "definition": "An abductor is a type of skeletal muscle responsible for moving a specific bone away from the body's midline. This action increases the angle between the limb and the central axis, facilitating lateral movement essential for fine motor control.",
      "provenance": {
        "aiDrafted": true,
