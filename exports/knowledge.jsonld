      ],
      "name": "ribosome",
      "entityType": "structure",
      "status": "canonical",
      "definition": "The ribosome is a cellular structure responsible for synthesizing proteins by translating genetic instructions from messenger RNA. Acting as the cell's primary protein factory, it ensures that essential enzymes and structural components are produced accurately.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
