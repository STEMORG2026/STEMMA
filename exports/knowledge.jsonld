      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "homeostasis",
      "entityType": "concept",
      "status": "canonical",
      "definition": "Homeostasis describes the biological capability of an organism to maintain stable internal conditions despite external environmental fluctuations. This dynamic equilibrium is essential for survival, ensuring that variables like temperature and pH remain within narrow limits.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
