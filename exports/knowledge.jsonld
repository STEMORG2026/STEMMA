      ],
      "name": "cytoplasm",
      "entityType": "structure",
      "status": "canonical",
      "definition": "Cytoplasm fills the entire region between the plasma membrane and nuclear envelope within a cell. It consists of organelles suspended in gel-like cytosol, supported by the cytoskeleton and various dissolved chemicals essential for life.",
