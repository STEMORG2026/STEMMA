      ],
      "name": "allele",
      "entityType": "concept",
      "status": "canonical",
      "definition": "An allele represents a specific variant form of a gene that arises from mutation and occupies the same locus on homologous chromosomes. Different alleles at a single location determine variations in inherited traits among individuals within a population.",
