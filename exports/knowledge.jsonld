      ],
      "name": "phenotype",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The phenotype represents the observable physical characteristics or traits expressed by an organism. These features result from the interaction between its genetic makeup and environmental influences, distinguishing them directly from underlying genotypes.",
