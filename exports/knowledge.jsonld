      ],
      "name": "acid-base indicator",
      "entityType": "instrument",
      "status": "canonical",
      "definition": "An acid-base indicator is a weak acid or base whose conjugate partner displays a distinct solution color. Scientists use this visual change to assess the pH of unknown solutions during titrations.",
