      ],
      "name": "luminosity",
      "entityType": "concept",
      "status": "canonical",
      "definition": "Luminosity measures the total rate at which an object emits electromagnetic energy into space. Unlike apparent brightness, this intrinsic property depends solely on the source power and distance-independent factors like stellar radius and surface temperature.",
