    {
      "@id": "stemma:bio.genotype",
      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "genotype",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The genotype constitutes the complete genetic makeup of an organism, encompassing both expressed and non-expressed alleles inherited from parents. This internal blueprint dictates potential physical characteristics but does not always directly match observable phenotypic traits.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
