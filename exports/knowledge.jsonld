      ],
      "name": "abductor pollicis longus",
      "entityType": "structure",
      "status": "canonical",
      "definition": "The abductor pollicis longus is a deep muscle that moves the thumb away from the plane of the palm. It inserts into the first metacarpal bone to assist in abduction and extension during grasping motions.",
