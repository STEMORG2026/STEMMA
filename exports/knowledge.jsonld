      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "mitosis",
      "entityType": "process",
      "status": "canonical",
      "definition": "Mitosis is a period of the cell cycle where duplicated chromosomes separate into identical nuclei. This process includes distinct phases like prophase and anaphase to ensure accurate genetic distribution.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
        "reviewedAt": "2026-10-20T00:00:00+00:00",
