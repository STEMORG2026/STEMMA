      ],
      "name": "species",
      "entityType": "concept",
      "status": "canonical",
      "definition": "A species defines a group of populations that interbreed naturally to produce fertile offspring. This classification relies on reproductive compatibility, ensuring genetic continuity while distinguishing distinct biological entities within the broader ecosystem.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
