      ],
      "name": "7-methylguanosine cap",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The 7-methylguanosine cap is a specific chemical modification added to the start of pre-messenger RNA transcripts. This structure shields the molecule from degradation and assists ribosomes in recognizing the mRNA for efficient translation.",
      "provenance": {
