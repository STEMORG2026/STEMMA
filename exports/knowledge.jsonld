      ],
      "name": "abductor digiti minimi",
      "entityType": "structure",
      "status": "canonical",
      "definition": "The abductor digiti minimi is a specific muscle located in the hand that moves the little finger away from the midline. It originates on the pisiform bone and inserts onto the fifth metacarpal to enable abduction of this digit.",
