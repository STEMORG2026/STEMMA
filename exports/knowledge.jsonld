      ],
      "name": "ecosystem",
      "entityType": "system",
      "status": "canonical",
      "definition": "An ecosystem represents a functional unit comprising all living organisms within a specific area alongside their nonliving environmental components. It functions through complex interactions where biotic factors depend on abiotic resources to sustain energy flow and nutrient cycling.",
      "provenance": {
        "aiDrafted": true,
