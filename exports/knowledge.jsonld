      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "neuron",
      "entityType": "structure",
      "status": "canonical",
      "definition": "A neuron is a specialized excitable cell designed to receive, process, and transmit electrical or chemical signals throughout the nervous system. These cells form intricate networks that enable rapid communication between different parts of an organism's body.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
