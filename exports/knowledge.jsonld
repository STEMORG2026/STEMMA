      ],
      "name": "population",
      "entityType": "concept",
      "status": "canonical",
      "definition": "A population comprises all individuals of a single species living within a specific geographic area. These groups interact through mating and competition, forming the fundamental unit for studying ecological dynamics and evolutionary changes over time.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
