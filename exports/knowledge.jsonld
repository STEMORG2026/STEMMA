      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "5' cap",
      "entityType": "concept",
      "status": "canonical",
      "definition": "A 5' cap is a methylated guanosine triphosphate molecule attached to the beginning of messenger RNA. This structure protects the transcript from enzymatic degradation and facilitates ribosome binding during the initiation of protein synthesis.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
