      ],
      "name": "cell",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The cell serves as the smallest fundamental unit of structure and function within all living organisms. It maintains life through specialized organelles that coordinate metabolic activities, reproduction, and response to environmental stimuli.",
