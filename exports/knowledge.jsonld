        "stemma:Concept"
      ],
      "name": "evolution",
      "entityType": "concept",
      "status": "canonical",
      "definition": "Descent with modification across generations, driven by mutation, genetic drift, gene flow, and natural selection. Over long spans it produces adaptation and new lineages, and it explains both the unity and diversity of living organisms.",
      "provenance": {
        "aiDrafted": true,
