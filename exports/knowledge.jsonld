      ],
      "name": "3' UTR",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The 3' untranslated region is a segment located downstream of the protein-coding sequence within an RNA molecule. This area remains untranslatted into amino acids but often contains regulatory elements that influence mRNA stability and translation efficiency.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
