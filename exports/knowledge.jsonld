      ],
      "name": "mitochondrion",
      "entityType": "structure",
      "status": "canonical",
      "definition": "A mitochondrion is a membrane-bound organelle enclosed by a double lipid bilayer that generates cellular energy in the form of ATP. Often called the powerhouse, it converts nutrients into usable chemical energy through oxidative phosphorylation processes.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
