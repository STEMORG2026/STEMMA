      ],
      "name": "acid-base reaction",
      "entityType": "process",
      "status": "canonical",
      "definition": "An acid-base reaction involves the transfer of a hydrogen ion between distinct reactant species. This proton exchange mechanism fundamentally alters the chemical identity and charge balance of participating molecules.",
      "provenance": {
        "aiDrafted": true,
