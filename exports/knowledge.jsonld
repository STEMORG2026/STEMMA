      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "mutation",
      "entityType": "concept",
      "status": "canonical",
      "definition": "A mutation constitutes a variation in the nucleotide sequence of an organism's genome. Such changes can alter genetic information, potentially leading to new traits or affecting biological functions depending on their location and nature within DNA.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
        "reviewedAt": "2026-10-20T00:00:00+00:00",
