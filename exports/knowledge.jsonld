      }
    },
    {
      "@id": "stemma:bio.natural-selection",
      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "natural selection",
      "entityType": "process",
      "status": "canonical",
      "definition": "Natural selection is a fundamental evolutionary process where individuals possessing advantageous traits survive environmental pressures better than others. This differential survival and reproduction cause favorable genetic characteristics to become more common in populations over successive generations.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
        "reviewedAt": "2026-10-20T00:00:00+00:00",
