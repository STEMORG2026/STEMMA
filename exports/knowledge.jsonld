      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "abduct",
      "entityType": "process",
      "status": "canonical",
      "definition": "To abduct is to move a body part or bone away from the midline in the sagittal plane. This motion typically occurs at joints like the shoulder or hip, increasing the angle between the limb and the torso.",
      "provenance": {
        "aiDrafted": true,
