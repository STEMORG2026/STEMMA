      ],
      "name": "acid anhydride",
      "entityType": "concept",
      "status": "canonical",
      "definition": "An acid anhydride is a specific compound that reacts with water molecules to form either an acid or an acidic solution. This transformation occurs because the oxide lacks hydrogen atoms initially present in its corresponding hydrated acid.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
