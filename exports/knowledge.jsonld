      }
    },
    {
      "@id": "stemma:bio.meiosis",
      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "meiosis",
      "entityType": "process",
      "status": "canonical",
      "definition": "Meiosis is a specialized nuclear division process resulting in four genetically unique haploid cells. It reduces chromosome number by half to facilitate sexual reproduction and genetic diversity.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
        "reviewer": "process:content-validator.v1",
        "reviewedAt": "2026-10-20T00:00:00+00:00",
