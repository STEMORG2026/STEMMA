      ],
      "name": "5' UTR",
      "entityType": "concept",
      "status": "canonical",
      "definition": "The 5' untranslated region is a segment located upstream of the coding sequence within an RNA molecule. Although not translated into protein, this area plays critical roles in regulating translation initiation and mRNA stability.",
      "provenance": {
