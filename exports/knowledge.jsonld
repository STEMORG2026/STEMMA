      "@type": [
        "skos:Concept",
        "stemma:Concept"
      ],
      "name": "immune system",
      "entityType": "system",
      "status": "canonical",
      "definition": "The immune system functions as a series of barriers, cells, and soluble mediators responding to infections. It coordinates complex defenses against pathogenic organisms, protecting the body from disease while maintaining internal stability.",
      "provenance": {
        "aiDrafted": true,
        "writer": "process:openstax-importer.v1",
