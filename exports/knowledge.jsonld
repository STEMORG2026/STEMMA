      ],
      "name": "cellular respiration",
      "entityType": "process",
      "status": "canonical",
      "definition": "Cellular respiration is the production of ATP from glucose oxidation through glycolysis and oxidative phosphorylation. This process releases energy stored in chemical bonds to power cellular activities.",
